generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SurveyCategory {
  SATISFACTION
  RATING
  POLL
}

enum AnswerType {
  REACTION
  RATING
  TEXT
  IMAGE
}

enum ResponseSource {
  KIOSK
  LINK
  QR
}

enum PlanType {
  INDIVIDUAL
  BUSINESS
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE // paid, renews
  CANCELED // auto-renew off: Pro until currentPeriodEnd
  PAST_DUE // renewal failed, provider retrying: Pro until currentPeriodEnd
  INCOMPLETE // first payment never completed: never Pro
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum MembershipEventType {
  LEFT
  REMOVED
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  // One owned organization per user, exactly one owner per organization
  ownerId           String   @unique
  activeSurveyCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner            User              @relation("OwnedOrganization", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships      Membership[]
  invitations      Invitation[]
  membershipEvents MembershipEvent[]
  // Legacy link, unused since memberships (dropped in docs/subscriptions.md phase 6)
  users            User[]
  surveys          Survey[]
  responses        SurveyResponse[]
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  passwordHash   String?
  // Legacy: the role lives in Membership; nothing reads or writes it (dropped in phase 6)
  role           Role      @default(MEMBER)
  // The account: an inactive or deleted user cannot sign in. Per organization: Membership.isActive
  isActive       Boolean   @default(true)
  // Legacy: organizations come from Membership; nothing reads or writes it (dropped in phase 6)
  organizationId String?
  deletedAt      DateTime?

  organization        Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownedOrganization   Organization?     @relation("OwnedOrganization")
  memberships         Membership[]
  subscription        Subscription?
  seat                SubscriptionSeat?
  invitationsSent     Invitation[]      @relation("InvitationsSent")
  invitationsReceived Invitation[]      @relation("InvitationsReceived")
  membershipEvents    MembershipEvent[]
  accounts            Account[]
  sessions            Session[]
  surveys             Survey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
}

// A paid plan, one per paying user (the plan owner), updated in place on renewal. isPro is never
// stored: a subscription is live while it is not INCOMPLETE and currentPeriodEnd has not passed
model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  planType           PlanType
  billingInterval    BillingInterval
  status             SubscriptionStatus @default(ACTIVE)
  // Last successful payment
  paidAt             DateTime?
  currentPeriodStart DateTime
  // Expiration: Pro until this instant
  currentPeriodEnd   DateTime
  canceledAt         DateTime?

  // Payment provider (none yet): optional, so a provider can be added without a reshape
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  seats       SubscriptionSeat[]
  invitations Invitation[]
}

// A Business plan member: Pro through the owner's subscription. A user holds at most one seat
model SubscriptionSeat {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String   @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// An invitation into an organization (docs/subscriptions.md, section 6). In-app for existing
// accounts (userId); email and token are for the email invites that come later, subscriptionId for
// Business plan invites (phase 5). Pending ones past expiresAt count as expired
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedById    String
  userId         String?
  email          String?
  token          String?          @unique
  subscriptionId String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  user         User?         @relation("InvitationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([subscriptionId, status])
}

// Who left an organization or was removed from it, kept for the owner's email (pending feature)
model MembershipEvent {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  type           MembershipEventType
  // Set once the owner has been told
  notifiedAt     DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
}

// A user in an organization. The owner has one too (role OWNER, the organization's ownerId), so
// lists and limits treat everyone alike
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  // Deactivated in this organization only
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, isActive])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Survey {
  id             String         @id @default(cuid())
  organizationId String
  createdById    String
  code           String         @unique @db.VarChar(6)
  name           String
  description    String         @default("")
  category       SurveyCategory
  isActive       Boolean        @default(false)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions    Question[]
  responses    SurveyResponse[]

  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@index([organizationId, updatedAt(sort: Desc)])
}

model Question {
  id         String    @id @default(cuid())
  surveyId   String
  text       String
  position   Int
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  options AnswerOption[]
  items   ResponseItem[]

  @@index([surveyId, position])
}

model AnswerOption {
  id         String     @id @default(cuid())
  questionId String
  type       AnswerType
  value      String
  label      String
  color      String     @default("")
  position   Int
  archivedAt DateTime?
  createdAt  DateTime   @default(now())

  question Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  items    ResponseItem[]

  @@index([questionId, position])
}

model SurveyResponse {
  id             String         @id @default(cuid())
  surveyId       String
  organizationId String
  source         ResponseSource
  deviceId       String?
  locale         String?
  durationMs     Int?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        ResponseItem[]

  @@index([surveyId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

model ResponseItem {
  id             String     @id @default(cuid())
  responseId     String
  questionId     String
  answerOptionId String
  answerType     AnswerType
  answerValue    String
  answerLabel    String

  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerOption AnswerOption   @relation(fields: [answerOptionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@index([answerOptionId])
}
