# Neon PostgreSQL, development branch. Never commit the real values (.env is git-ignored).
# Pooled connection (host with -pooler): the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection: Prisma CLI (migrations, Studio)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Base URL for public survey links and QR codes
PANDA_PUBLIC_URL="http://localhost:3000"

# Endpoint id of the Neon development branch (ep-...): prisma/seed.ts refuses any other database
NEON_DEV_ENDPOINT="ep-xxx"

# Auth.js: signs and encrypts the session cookie. Generate with `npx auth secret`
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials, docs/auth.md section 3)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Self-hosted production (`next start` behind your own domain or proxy): trust the request host
# AUTH_TRUST_HOST=true
